DATABASE_URL=postgresql://...   # Supabase Postgres connection string
AUTH_SECRET=                    # long random string (openssl rand -hex 32)
MAX_SLOTS=50
SUPABASE_URL=
SUPABASE_SERVICE_KEY=           # server only, never exposed to browser
EMAIL_API_KEY=                  # Resend API key
EMAIL_FROM="HFTD <noreply@yourdomain.com>"
ALLOWED_EMAIL_DOMAINS=          # optional, e.g. comsats.edu.pk (empty = any)
ADMIN_USERNAME=                 # used only by npm run seed
ADMIN_PASSWORD=
